%% Scope: storage-owned pull architecture (LMCache runs on both compute and storage nodes).
%% For the initiator-owned + remote-NVMe-oF-L2 alternative, see
%%   docs/design/v1/platform/ipu-poc/nvmeof-initiator-only-alternative.md
%%   docs/design/v1/platform/ipu-poc/lmcache-nvmeof-jbof-flow.mmd
sequenceDiagram
    participant vLLM as Xeon GNR-SP<br/>(vLLM / Bench)
    participant LMC_I as Xeon GNR-SP<br/>(LMCache: minimal)
    participant IPU_I as MMG-400 Falcon<br/>(Passive responder)
    participant IPU_T as MMG-400 Falcon<br/>(Active data mover)
    participant LMC_T as Xeon GNR-SP<br/>(LMCache control plane)
    participant SSD as NVMe Gen5<br/>(L2)

    Note over vLLM,SSD: High-level target flow.<br/>See lmcache-ipu-pull-model-flow.mmd for wire-level detail:<br/>control frames, MR lifetime, two-phase eviction, lease and cancel semantics.

    Note over vLLM,SSD: === RETRIEVE ===

    vLLM->>LMC_I: retrieve(tokens)
    LMC_I->>LMC_T: request (keys + dst descriptor)
    alt HIT (L1 or L2)
        LMC_T->>IPU_T: post RDMA Write
        IPU_T-->>IPU_I: RDMA Write over 400GbE
        IPU_I-->>LMC_I: data landed in dst buffer
        LMC_T-->>LMC_I: ACK
        LMC_I-->>vLLM: KV ready
    else MISS
        LMC_T-->>LMC_I: miss
        LMC_I-->>vLLM: recompute KV
    end

    Note over vLLM,SSD: === STORE (Pull Model) ===

    vLLM->>LMC_I: store(tokens, kv)
    LMC_I->>LMC_I: prepare source buffer + BLAKE3 digest D
    LMC_I->>LMC_T: write intent (key, digest D)

    Note over LMC_I,LMC_T: Admission decision

    alt ALREADY_PRESENT (dedup — idempotent terminal success)
        LMC_T-->>LMC_I: ACK
        LMC_I->>LMC_I: release source buffer
    else REJECT (over-quota / fenced — terminal)
        LMC_T-->>LMC_I: NACK
        LMC_I->>LMC_I: release source buffer
    else QUEUE (no capacity — MR stays pinned under lease)
        LMC_T-->>LMC_I: QUEUED
        alt lease expires (terminal)
            LMC_T-->>LMC_I: EXPIRE
            LMC_I->>LMC_I: release source buffer
        else initiator cancels (terminal)
            LMC_I->>LMC_T: CANCEL
            LMC_T-->>LMC_I: CANCEL ACK
            LMC_I->>LMC_I: release source buffer
        else capacity available (dequeue → ACCEPT)
            LMC_T-->>LMC_I: ACCEPT
            Note over vLLM,SSD: Target owns the pull (post-queue admission)
            alt L1 slot reserved (free slot, or durable eviction of LRU to L2 succeeded)
                LMC_T->>IPU_T: post RDMA Read from initiator's source buffer
                IPU_T-->>IPU_I: RDMA Read Request over 400GbE
                IPU_I-->>IPU_T: RDMA Read Response (page data)
                IPU_T-->>LMC_T: page landed at target
                LMC_T->>LMC_T: recompute BLAKE3 and validate against D
                alt VALIDATE OK
                    LMC_T->>LMC_T: commit — publish (key → page)
                    LMC_T-->>LMC_I: store ACK (terminal)
                    LMC_I->>LMC_I: release source buffer
                else VALIDATE FAIL
                    LMC_T->>LMC_T: discard page (not published)
                    LMC_T-->>LMC_I: NACK (integrity)
                    LMC_I->>LMC_I: release source buffer
                end
            else L1 full and LRU flush to L2 failed — no reservation, no RDMA
                LMC_T-->>LMC_I: NACK (capacity)
                LMC_I->>LMC_I: release source buffer
            end
        end
    else ACCEPT (capacity available immediately)
        Note over vLLM,SSD: Target owns the pull
        alt L1 slot reserved (free slot, or durable eviction of LRU to L2 succeeded)
            LMC_T->>IPU_T: post RDMA Read from initiator's source buffer
            IPU_T-->>IPU_I: RDMA Read Request over 400GbE
            IPU_I-->>IPU_T: RDMA Read Response (page data)
            IPU_T-->>LMC_T: page landed at target
            LMC_T->>LMC_T: recompute BLAKE3 and validate against D
            alt VALIDATE OK
                LMC_T->>LMC_T: commit — publish (key → page)
                LMC_T-->>LMC_I: store ACK (terminal)
                LMC_I->>LMC_I: release source buffer
            else VALIDATE FAIL
                LMC_T->>LMC_T: discard page (not published)
                LMC_T-->>LMC_I: NACK (integrity)
                LMC_I->>LMC_I: release source buffer
            end
        else L1 full and LRU flush to L2 failed — no reservation, no RDMA
            LMC_T-->>LMC_I: NACK (capacity)
            LMC_I->>LMC_I: release source buffer
        end
    end
