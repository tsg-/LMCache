---
title: "LMCache IPU Transfer Path — Transport Backend Options"
---
graph BT
    %% Hardware / kernel
    NIC["ConnectX-7 NIC · hardware RDMA DMA · RoCEv2 wire"]
    MLX5["mlx5_ib kernel driver"]
    NIC --> MLX5

    %% Native (pyverbs) path
    LIBIBV_N["libibverbs
ibv_reg_mr · ibv_post_send · ibv_poll_cq"]
    MLX5 --> LIBIBV_N
    PYVERBS["pyverbs (rdma-core)"]
    LIBIBV_N --> PYVERBS
    VERBS["VerbsRdmaTransport"]
    PYVERBS --> VERBS

    %% NIXL/UCX path
    LIBIBV_U["libibverbs"]
    MLX5 --> LIBIBV_U
    UCT["UCT rc_mlx5
(QP mgmt, doorbell batching, multi-rail)"]
    LIBIBV_U --> UCT
    LIBUCP["libucp
ucp_mem_map (MR cache) · ucp_get_nbx (Read)
ucp_put_nbx (Write) · ucp_worker_progress"]
    UCT --> LIBUCP
    UCXPY["ucx-py / pynixl (pip)"]
    LIBUCP --> UCXPY
    NIXL["NixlTransferModule
(nixl_transfer.py)"]
    UCXPY --> NIXL

    %% pyverbs path — RdmaTransport Protocol
    PROTO["RdmaTransport protocol
register_mr · post_read · post_write · poll_completion"]
    VERBS --> PROTO
    RDMA_MOD["RdmaTransferModule.store() / .retrieve()
(admission control, chunk commit, MQ response gating)"]
    PROTO --> RDMA_MOD

    %% NIXL path — direct server interface, no RdmaTransport protocol
    NIXL_MOD["NixlTransferModule.store() / .retrieve()
(add_remote_agent · initialize_xfer · poll → DONE)"]
    NIXL --> NIXL_MOD

