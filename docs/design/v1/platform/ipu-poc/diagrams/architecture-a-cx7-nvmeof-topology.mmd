%%{init: {"theme": "default", "flowchart": {"htmlLabels": true}}}%%
graph LR
    subgraph INIT ["Initiator / Compute Node (CX7 platform: Xeon + CX7)"]
        direction TB
        GPU["GPU HBM<br/>(L0)"]
        CPU_I["Xeon host<br/>LMCache Engine + StorageManager<br/>WAL, allocator, key→LBA map"]
        L1["Initiator DRAM<br/>(L1)<br/>pinned MR buffers"]
        NVME_I["Linux kernel<br/>nvme_rdma initiator"]
        HCA_I["Initiator HCA<br/>CX7 mlx5_1<br/>(MEV / MMG platforms: may replace the selected<br/>transport endpoint; see D-init / D-tgt / D-both)"]
        GPU --- CPU_I
        CPU_I --- L1
        CPU_I --- NVME_I
        NVME_I --- HCA_I
    end

    subgraph TARGET ["Storage / NVMe-oF Target Node (CX7 platform: Xeon + CX7)"]
        direction TB
        HCA_T["Target HCA<br/>CX7 rocep153s0f0<br/>(MEV / MMG platforms: may replace the selected<br/>transport endpoint; see D-init / D-tgt / D-both)"]
        NVMET["Linux kernel<br/>nvmet_rdma<br/>NQN ACL + namespace export"]
        TDRAM["Target DRAM<br/>(staging only —<br/>NOT an LMCache tier)"]
        SSD["Dedicated NVMe<br/>namespace (L2 media)"]
        HCA_T --- NVMET
        NVMET --- TDRAM
        NVMET --- SSD
    end

    HCA_I ==>|"NVMe-oF/RDMA (RoCEv2)<br/>192.168.200 data plane<br/>active_mtu=IBV_MTU_4096"| HCA_T

    classDef owned fill:#c8e6c9,stroke:#2e7d32;
    classDef remote fill:#fff9c4,stroke:#f9a825;
    classDef staging fill:#e0e0e0,stroke:#616161,color:#424242;
    classDef offload fill:#e3f2fd,stroke:#1976d2,stroke-dasharray:5 3;
    class L1 owned;
    class SSD remote;
    class TDRAM staging;
    class HCA_I,HCA_T offload;
