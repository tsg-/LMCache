        end
        SSD["Illustrative NVMe Gen5 (L2)"]
        NIC_K["E835 2x200GbE"]
        IPU_K["MMG-400"]
    end

    NIC_I ---|"2x200GbE"| NIC_K
    IPU_I ===|"400GbE"| IPU_K

    style HBM fill:#ffcdd2,stroke:#c62828
    style DRAM fill:#fff9c4,stroke:#f9a825
