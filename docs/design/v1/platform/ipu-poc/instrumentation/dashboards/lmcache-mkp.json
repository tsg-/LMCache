  "description": "IPU PoC — mkp1/mkp2 host, fabric, NVMe, and bench l2 view.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "title": "LMCache bench l2 (short-lived endpoint)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "description": "Application payload goodput reported by the running bench l2 process. Use the end-of-run JSON and counter gate for publishable throughput; this panel aligns the workload with host and RDMA trends.",
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(lmcache_bench_l2_success_bytes_total{job=\"lmcache_bench\",phase=\"measured\"}[60s]) * 8",
          "legendFormat": "{{host}} {{operation}}"
        }
      ],
      "title": "LMCache measured goodput [TREND ONLY]",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(lmcache_bench_l2_completed_submits_total{job=\"lmcache_bench\",phase=\"measured\"}[60s])",
          "legendFormat": "{{host}} {{operation}}"
        }
      ],
      "title": "LMCache completed submits/s",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "description": "Mean submit-to-completion latency over the query window. The endpoint intentionally does not expose live percentiles; use the final benchmark summary for p50/p99.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "rate(lmcache_bench_l2_submit_latency_seconds_total{job=\"lmcache_bench\",phase=\"measured\"}[60s]) / rate(lmcache_bench_l2_completed_submits_total{job=\"lmcache_bench\",phase=\"measured\"}[60s])",
          "legendFormat": "{{host}} {{operation}}"
        }
      ],
      "title": "LMCache mean submit latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "expr": "lmcache_bench_l2_in_flight_target{job=\"lmcache_bench\",phase=\"measured\"}",
          "legendFormat": "{{host}} {{operation}}"
        }
      ],
      "title": "LMCache configured in-flight submits",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "title": "Block I/O by role",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{host=\"mkp1\",device=~\"md.+\"}[15s])",
