        }
      ],
      "title": "Initiator RAID0 throughput (mkp1 md0)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{host=\"mkp2\",device=~\"nvme.+\"}[15s])",
          "legendFormat": "{{device}} read"
        },
        {
          "expr": "rate(node_disk_written_bytes_total{host=\"mkp2\",device=~\"nvme.+\"}[15s])",
          "legendFormat": "{{device}} write"
        }
      ],
      "title": "Target SSD throughput (mkp2 NVMe)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "expr": "node_disk_io_now{host=\"mkp1\",device=~\"md.+\"}",
          "legendFormat": "{{device}}"
        }
      ],
      "title": "Initiator RAID0 queue depth (mkp1)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "expr": "node_disk_io_now{host=\"mkp2\",device=~\"nvme.+\"}",
          "legendFormat": "{{device}}"
        }
      ],
      "title": "Target SSD queue depth (mkp2)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "title": "RDMA fabric (200.0.0.x plane, ens2f0 / irdma)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "description": "InRdmaWrites: an NVMe-oF READ is satisfied by the target RDMA-writing into initiator memory. RDMA write segments cap at ~52428 B, so bytes = ops * 52428 for I/O >= 256 KiB. This is the ONLY instrument that sees RDMA payload on irdma — ethtool port_rx_bytes does not account offloaded traffic.\n\nDO NOT QUOTE PEAKS FROM THIS PANEL. Three unsynchronized sampling stages (irdma refreshes hw_counters asynchronously ~1s, systemd timer regenerates the textfile at 2s, Prometheus scrapes at 5s) alias the rate. Measured 2026-08-03: a run the bench recorded at 94.4 Gbps showed a 75.6 Gbps peak here, with visibly stepped values. Integrated bytes over a long window are sound; instantaneous peak is understated. For a number that goes in a document, bracket the workload with an explicit counter delta.",
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "rate(rdma_hw_counter{counter=\"InRdmaWrites\"}[15s]) * 52428 * 8",
          "legendFormat": "{{host}}:{{device}} read payload"
        }
      ],
      "title": "RDMA payload — reads (target→initiator) [TREND ONLY]",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "description": "InRdmaReads: an NVMe-oF WRITE makes the target RDMA-read from initiator memory. Measured at exactly 4096 B per op, block-size invariant. Payloads <= 4 KiB ride in-capsule (OutRdmaSends only) and register zero RDMA read ops.\n\nSame aliasing caveat as the read panel — trend only, do not quote peaks. Note the store path is media-bound at ~5.6 GB/s (45 Gbps) on 2x PM9A3, so this panel should NOT be expected to approach the read panel's ceiling.",
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "expr": "rate(rdma_hw_counter{counter=\"InRdmaReads\"}[15s]) * 4096 * 8",
          "legendFormat": "{{host}}:{{device}} write payload"
        }
      ],
      "title": "RDMA payload — writes (initiator→target) [TREND ONLY]",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "description": "ethtool port counters. On irdma these do NOT include RDMA-offloaded payload — a 34 GB RDMA read moved port_rx_bytes by ~3.8 KB. Useful for control/TCP traffic and as a sanity check, NOT for throughput.",
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "expr": "rate(rdma_nic_stat{name=\"port_rx_bytes\"}[30s]) * 8",
          "legendFormat": "{{host}}:{{iface}} rx"
        },
        {
          "expr": "rate(rdma_nic_stat{name=\"port_tx_bytes\"}[30s]) * 8",
          "legendFormat": "{{host}}:{{iface}} tx"
        }
      ],
      "title": "Fabric NIC wire bytes/s (control plane only)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "description": "irdma names xon/xoff events rather than mlx5's *_pause_phy. Nonzero xoff means the link is asserting backpressure.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "expr": "rate(rdma_nic_stat{name=~\"port_(rx|tx)_(xon|xoff)_events\"}[30s])",
          "legendFormat": "{{host}} {{name}}"
        },
        {
          "expr": "rate(rdma_nic_stat{name=~\"port_(rx|tx)_dropped.*|.*csum_errors|.*length_errors\"}[30s])",
          "legendFormat": "{{host}} {{name}}"
        }
      ],
      "title": "Flow control / errors / drops",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "description": "irdma hw_counters error family. Retransmits under load indicate fabric trouble, not host trouble.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "targets": [
        {
          "expr": "rate(rdma_hw_counter{counter=~\".*[Rr]etrans.*|.*[Ee]rr.*|.*[Dd]rop.*\"}[30s])",
          "legendFormat": "{{host}} {{counter}}"
        }
      ],
      "title": "RDMA retransmits / errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 51
      },
      "targets": [
        {
          "expr": "rdma_port_up",
          "legendFormat": "{{host}}:{{device}} port {{port}}"
        }
      ],
      "title": "RDMA link up",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 59
      },
      "title": "CPU / Memory",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 60
      },
      "targets": [
        {
          "expr": "100 - (avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\"}[30s])) * 100)",
          "legendFormat": "{{host}}"
        }
      ],
      "title": "CPU usage % (per host)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 60
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "{{host}}"
        }
      ],
      "title": "Memory used (per host)",
      "type": "timeseries"
    }
  ],
