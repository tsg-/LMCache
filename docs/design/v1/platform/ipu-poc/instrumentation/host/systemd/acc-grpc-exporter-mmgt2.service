[Unit]
Description=Serve target ACC counters at Prometheus scrape time
Requires=acc-grpc-tunnel@acc5.service acc-grpc-tunnel@acc6.service
After=acc-grpc-tunnel@acc5.service acc-grpc-tunnel@acc6.service

[Service]
Type=simple
ExecStart=/opt/acc-grpc-telemetry/venv/bin/python /usr/local/bin/acc_grpc_exporter.py --proto-dir /opt/acc-grpc-telemetry/proto --accs 5,6
Restart=always
RestartSec=2s

[Install]
WantedBy=multi-user.target
