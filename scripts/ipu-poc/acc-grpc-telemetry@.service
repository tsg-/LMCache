[Unit]
Description=Continuously collect %i ACC gRPC transport counters for node_exporter
Requires=acc-grpc-tunnel@%i.service
After=acc-grpc-tunnel@%i.service

[Service]
Type=simple
EnvironmentFile=/etc/default/acc-grpc-%i
ExecStart=/usr/bin/env ${ACC_GRPC_PYTHON} /usr/local/bin/acc_telemetry_textfile.py --loop
Restart=always
RestartSec=2s

[Install]
WantedBy=multi-user.target
